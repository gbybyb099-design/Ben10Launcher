name: Build APK
on: [workflow_dispatch, push]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: android-actions/setup-android@v3
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.9"
      - run: unzip -q Ben10Launcher.zip
      - run: cd Ben10Launcher && gradle assembleDebug --no-daemon
      - uses: actions/upload-artifact@v4
        with:
          name: Ben10Launcher-apk
          path: Ben10Launcher/app/build/outputs/apk/debug/app-debug.apk
